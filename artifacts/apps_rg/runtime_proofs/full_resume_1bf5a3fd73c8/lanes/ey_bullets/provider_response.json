      "text": "{\"bullets\":[{\"bullet_id\":\"b1\",\"bullet_text\":\"Led quantitative derivatives, variable-annuity hedging, and insurance-capital initiatives, applying exotic pricing, liability Greeks, and higher-order stress testing to design robust hedge structures for regulated financial institutions.\",\"source_fact_ids\":[\"bul_ey_001\"]},{\"bullet_id\":\"b2\",\"bullet_text\":\"Directed CCAR-era capital, liquidity, and stress-testing engagements, structuring traceable scenarios and challenger models alongside model-risk remediation to produce audit-grade governance evidence.\",\"source_fact_ids\":[\"bul_ey_002\"]},{\"bullet_id\":\"b3\",\"bullet_text\":\"Architected enterprise risk management operating models aligned to BCBS 239, defining three-lines-of-defense accountability, metadata standards, and auditable risk metrics across regulated institutions.\",\"source_fact_ids\":[\"bul_ey_003\"]}],\"claim_ledger\":[{\"claim_text\":\"Led quantitative derivatives, variable-annuity hedging, and insurance-capital work using exotic pricing, liability Greeks, higher-order stress testing, and hedge design.\",\"source_fact_ids\":[\"bul_ey_001\"]},{\"claim_text\":\"Led CCAR-era capital, liquidity, stress testing, and model-validation work by structuring traceable scenarios, challenger variants, model-risk remediation, and governance evidence for regulated financial institutions.\",\"source_fact_ids\":[\"bul_ey_002\"]},{\"claim_text\":\"Architected ERM operating models and BCBS 239-aligned risk-data aggregation by defining three-lines-of-defense accountability, metadata standards, and auditable risk metrics.\",\"source_fact_ids\":[\"bul_ey_003\"]}],\"jd_alignment\":{\"targeting_only\":true,\"jd_used_as_proof\":false}}",
